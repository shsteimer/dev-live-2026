{
  "name": "dev-live-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AEM Dev Live 2026 demo site (Edge Delivery Services)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:js": "eslint . --ext .js,.cjs",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test": "node --test \"test/**/*.test.js\"",
    "pretest:e2e": "node test/support/sync-e2e-content.js",
    "test:e2e": "playwright test",
    "content:reset": "rm -rf content && aem content clone --all",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shsteimer/dev-live-2026.git"
  },
  "author": "Sean Steimer",
  "license": "Apache License 2.0",
  "homepage": "https://github.com/shsteimer/dev-live-2026#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@playwright/test": "^1.64.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
